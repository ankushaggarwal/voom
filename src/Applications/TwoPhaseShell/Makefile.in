	-rm -f ./$(DEPDIR)/minimize-indent-restart.Po
	-rm -f ./$(DEPDIR)/minimize-indent.Po
	-rm -f ./$(DEPDIR)/minimize-tubule.Po
	-rm -f ./$(DEPDIR)/minimize.Po
	-rm -f ./$(DEPDIR)/normal-modes.Po
	-rm -f Makefile
distclean-am: clean-am distclean-compile distclean-generic \
	distclean-tags

dvi: dvi-am


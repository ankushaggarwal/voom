	-rm -f $(am__CONFIG_DISTCLEAN_FILES)
	-rm -rf $(top_srcdir)/autom4te.cache
		-rm -f ./$(DEPDIR)/SHenergy-nonuniformR.Po
	-rm -f ./$(DEPDIR)/SHenergy.Po

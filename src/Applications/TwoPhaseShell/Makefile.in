		-rm -f ./$(DEPDIR)/SHenergy-nonuniformR.Po
	-rm -f ./$(DEPDIR)/SHenergy.Po
	-rm -f ./$(DEPDIR)/SHenergy2.Po
	-rm -f ./$(DEPDIR)/calStrain.Po
	-rm -f ./$(DEPDIR)/calStrain2.Po
	-rm -f ./$(DEPDIR)/homog2D.Po
	-rm -f ./$(DEPDIR)/homog2Dicossym.Po
	-rm -f ./$(DEPDIR)/homog2Dtable.Po

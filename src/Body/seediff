  //! compute stiffness						  //! compute stiffness
  template< class Material_t >					  template< class Material_t >
  void LoopShellBody<Material_t>::_computeStiffness()		  void LoopShellBody<Material_t>::_computeStiffness()
  { 								  { 
    // build table of elements connected to each node 		    // build table of elements connected to each node 
    std::vector< std::vector< FeElement_t* > > elementMap;	    std::vector< std::vector< FeElement_t* > > elementMap;
    elementMap.resize(_shellNodes.size());			    elementMap.resize(_shellNodes.size());
    for(int si=0; si<_shells.size(); si++) {			    for(int si=0; si<_shells.size(); si++) {
	if( !_active[si] ) continue;					if( !_active[si] ) continue;
	FeElement_t* s=_shells[si];					FeElement_t* s=_shells[si];
	for(int ni=0; ni<s->nodes().size(); ni++) {			for(int ni=0; ni<s->nodes().size(); ni++) {
	  FeNode_t * n = s->nodes()[ni];				  FeNode_t * n = s->nodes()[ni];
	  elementMap[ n->id() ].push_back( s );				  elementMap[ n->id() ].push_back( s );
	}								}
    }								    }
    								    
    //  perturb nodes to compute stiffness			    //  perturb nodes to compute stiffness
    for(int a=0; a<_shellNodes.size(); a++) {			    for(int a=0; a<_shellNodes.size(); a++) {
	FeNode_t * n = _shellNodes[a];					FeNode_t * n = _shellNodes[a];
	for(int i=0; i<3; i++) n->setStiffness(i,0.0);			for(int i=0; i<3; i++) n->setStiffness(i,0.0);

	const double h = 1.0e-6;					const double h = 1.0e-6;

	for(int i=0; i<3; i++) {					for(int i=0; i<3; i++) {
	  compute(false,false,false); // for global geometry 		  compute(false,false,false); // for global geometry 
	  n->setForce(i,0.0);						  n->setForce(i,0.0);

	  // push point forward						  // push point forward
	  n->addPoint(i, h); 						  n->addPoint(i, h); 
	  // compute and assemble element forces			  // compute and assemble element forces
	  for(int e=0; e<elementMap[ n->id() ].size(); e++) {		  for(int e=0; e<elementMap[ n->id() ].size(); e++) {
	    elementMap[ n->id() ][ e ]->compute(false,true,fa		    elementMap[ n->id() ][ e ]->compute(false,true,fa
	  }								  }
	  double fia=n->getForce(i);					  double fia=n->getForce(i);
	  								  
	  n->setForce(i,0.0);						  n->setForce(i,0.0);

	  // push point backward					  // push point backward
	  n->addPoint(i, -h-h); 					  n->addPoint(i, -h-h); 
	  // compute and assemble element forces			  // compute and assemble element forces
	  for(int e=0; e<elementMap[ n->id() ].size(); e++) {		  for(int e=0; e<elementMap[ n->id() ].size(); e++) {
	    elementMap[ n->id() ][ e ]->compute(false,true,fa		    elementMap[ n->id() ][ e ]->compute(false,true,fa
	  }								  }
	  fia-=n->getForce(i);						  fia-=n->getForce(i);

	  fia /= 2.0*h;							  fia /= 2.0*h;
	  n->setStiffness(i,fia);					  n->setStiffness(i,fia);
	  								  
	  // return point						  // return point
	  n->addPoint(i, -h-h); 					  n->addPoint(i, -h-h); 
	  n->setForce(i,0.0);						  n->setForce(i,0.0);
	}								}
      }    							      }    
  }								  }

